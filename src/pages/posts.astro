---
import { tools } from '../lib/data.mjs';

const posts = [
  {
    title: "Best Socket Set for DIY Mechanics: I Bought 3 Wrong Ones Before Finding the Right One",
    url: "/posts/best-socket-set-review",
    desc: "I bought 3 socket sets before I got it right. A $20 one, a 258-piece master set I barely used, and one that clicked. Here is what to look for.",
    date: "2026-09-09",
    cat: "Reviews"
  },
  {
    title: "Best Torque Wrench for DIY Mechanics: Don't Snap a Bolt Like I Did",
    url: "/posts/best-torque-wrench-review",
    desc: "I snapped a caliper bolt because I guessed the torque. I tested 4 torque wrenches. Here is what I learned about accuracy, cost, and which one to buy.",
    date: "2026-09-07",
    cat: "Reviews"
  },
  {
    title: "Best Jump Starter for Your Car: I Tested 5 So You Don't Have To",
    url: "/posts/best-jump-starter-review",
    desc: "My battery died in a parking lot at 10pm. That night I ordered 3 jump starters. Here is what I learned.",
    date: "2026-09-05",
    cat: "Guides"
  },
  {
    title: "Best OBD2 Scanner for Home Mechanics: What I Learned After Buying 3 Wrong Ones",
    url: "/posts/best-obd2-scanner-review",
    desc: "I bought 3 OBD2 scanners before finding the right one. Here is what I learned about what actually matters for DIY car repair.",
    date: "2026-09-05",
    cat: "Reviews"
  },
  {
    title: "Floor Jack Safety: 5 Things Nobody Told Me Before I Started Working Under My Car",
    url: "/posts/floor-jack-safety-tips",
    desc: "I almost learned this the hard way. These 5 floor jack safety tips will keep you alive while working on your car.",
    date: "2026-09-04",
    cat: "Guides"
  }
];
const catSlugs = Object.keys(tools);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Articles — Garage Tools DB</title>
  <meta name="description" content="Honest reviews and guides for DIY car repair tools. Learn from mistakes so you do not have to make your own." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/styles/global.css">
    <!-- Analytics -->
    <script>(function(){var p=window.location.pathname;var r=document.referrer||'';(new Image()).src='http://localhost:8085/track?s=garagetoolsdb&p='+encodeURIComponent(p)+'&r='+encodeURIComponent(r)})();</script>
  </head>
<body>
  <header>
    <div class="container">
      <a href="/" class="logo">🔧 GarageToolsDB</a>
      <button class="burger" id="burger" onclick="toggleNav()">
        <span></span><span></span><span></span>
      </button>
      <nav id="nav">
        <a href="/">Home</a>
        <a href="/posts">Blog</a>
        <div class="nav-item" onclick="if(window.innerWidth<=640)this.classList.toggle('open')">
          <span class="nav-trigger">Tools</span>
          <div class="dropdown">
            {Object.keys(tools).map(slug => (
              <a href={`/tools/${tools[slug].slug}`}>{tools[slug].short}</a>
            ))}
          </div>
        </div>
      </nav>
    </div>
  </header>

  <main class="container">
    <div style="margin-bottom:32px;">
      <h1>All Articles</h1>
      <p style="color:var(--muted);">Honest reviews and DIY guides from someone who bought the wrong tool so you do not have to.</p>
    </div>

    {posts.map(p => (
      <a href={p.url} class="preview-card" style="display:block;text-decoration:none;color:inherit;">
        <div class="preview-body">
          <div style="color:var(--muted);font-size:0.78rem;margin-bottom:4px;">{p.cat} · {p.date}</div>
          <h3>{p.title}</h3>
          <p class="preview-desc">{p.desc}</p>
        </div>
      </a>
    ))}
  </main>

  <footer>
    <div class="container">
      <p>© 2026 Garage Tools DB. As an Amazon Associate I earn from qualifying purchases.</p>
    </div>
  </footer>
</body>
</html>

<script is:inline>
  function toggleNav() {
    document.getElementById('nav').classList.toggle('open');
    document.getElementById('burger').classList.toggle('open');
  }
  document.addEventListener('click', function(e) {
    const link = e.target.closest('a');
    if (link && link.hostname !== location.hostname && link.hostname !== '') {
      link.target = '_blank';
      link.rel = 'noopener';
    }
  });
</script>
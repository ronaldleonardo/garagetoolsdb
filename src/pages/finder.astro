---
import { tools } from '../lib/data.mjs';
const toolData = JSON.stringify(Object.entries(tools).map(([slug, cat]) => ({
  slug, name: cat.name, desc: cat.desc, products: cat.products
})));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tool Finder — Garage Tools DB</title>
  <meta name="description" content="Find the right tool for your car project. Answer a few questions and get matched." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <header>
    <div class="container">
      <div class="header-inner">
        <a href="/" class="logo">Garage Tools DB</a>
      </div>
    </div>
  </header>
  <main>
    <div class="container">
      <div style="text-align:center;padding:32px 0">
        <h1>Find Your Tool</h1>
        <p style="color:var(--muted)">Tell us what you need and we will match you.</p>
      </div>

      <div style="display:flex;gap:24px;align-items:start;flex-wrap:wrap">
        <div style="width:240px;flex-shrink:0;background:var(--surface);border:2px solid var(--border);border-radius:10px;padding:16px;position:sticky;top:16px">
          <div style="margin-bottom:16px">
            <label style="font-weight:600;font-size:0.85rem;display:block;margin-bottom:4px">Tool Type</label>
            <select id="cat" style="width:100%;padding:6px 8px;border:2px solid var(--border);border-radius:6px;font-size:0.9rem">
              <option value="all">All Tools</option>
              {Object.keys(tools).map(s => `<option value="${s}">${tools[s].name}</option>`).join('')}
            </select>
          </div>
          <div style="margin-bottom:16px">
            <label style="font-weight:600;font-size:0.85rem;display:block;margin-bottom:4px">Max Budget</label>
            <select id="budget" style="width:100%;padding:6px 8px;border:2px solid var(--border);border-radius:6px;font-size:0.9rem">
              <option value="0">Any</option>
              <option value="50">Under $50</option>
              <option value="100">Under $100</option>
              <option value="200">Under $200</option>
              <option value="500">Under $500</option>
            </select>
          </div>
          <div style="margin-bottom:16px">
            <label style="font-weight:600;font-size:0.85rem;display:block;margin-bottom:4px">Tier</label>
            <select id="tier" style="width:100%;padding:6px 8px;border:2px solid var(--border);border-radius:6px;font-size:0.9rem">
              <option value="all">Any</option>
              <option value="top">Best Overall</option>
              <option value="budget">Budget Pick</option>
              <option value="value">Best Value</option>
            </select>
          </div>
          <button id="reset" style="width:100%;padding:6px;border:2px solid var(--border);border-radius:6px;background:var(--surface);cursor:pointer;font-weight:600">Reset</button>
        </div>

        <div style="flex:1;min-width:0">
          <p id="count" style="font-size:0.9rem;color:var(--muted);margin:0 0 12px"></p>
          <div id="results" style="display:flex;flex-direction:column;gap:8px"></div>
        </div>
      </div>
    </div>
  </main>
  <script>
  const DATA = JSON.parse(JSON.stringify({toolData}));
  const results = document.getElementById('results');
  const count = document.getElementById('count');

  function filter() {
    const cat = document.getElementById('cat').value;
    const budget = parseInt(document.getElementById('budget').value);
    const tier = document.getElementById('tier').value;
    let items = [];
    DATA.forEach(c => {
      if (cat !== 'all' && c.slug !== cat) return;
      c.products.forEach(p => {
        const price = parseFloat(p.price.replace('$',''));
        if (budget > 0 && price > budget) return;
        if (tier !== 'all' && p.badge !== tier) return;
        items.push({...p, catName: c.name, catSlug: c.slug});
      });
    });
    if (!items.length) {
      results.innerHTML = '<p style="text-align:center;padding:32px;color:var(--muted)">No tools match. Try widening your filters.</p>';
      count.textContent = '';
      return;
    }
    items.sort((a,b) => parseFloat(b.rating) - parseFloat(a.rating));
    count.textContent = items.length + ' tool' + (items.length > 1 ? 's' : '') + ' match';
    results.innerHTML = items.map(p => `
      <div style="display:flex;gap:12px;align-items:center;background:var(--surface);border:2px solid var(--border);border-radius:10px;padding:12px">
        <img src="${p.img}" alt="${p.name}" style="width:60px;height:60px;object-fit:contain;border-radius:6px;background:#f8f9fa;flex-shrink:0" />
        <div style="flex:1;min-width:0">
          <strong style="font-size:0.9rem">${p.name}</strong>
          <div style="font-size:0.78rem;color:var(--muted)">${p.catName} &middot; ★ ${p.rating}</div>
          <div style="font-size:0.78rem;color:#555">${p.pros}</div>
        </div>
        <div style="text-align:right;flex-shrink:0">
          <div style="font-weight:700;font-size:1rem">${p.price}</div>
          <a href="${p.asin ? 'https://www.amazon.com/s?k=' + encodeURIComponent(p.name) + '&tag=tabletopharve-20' : '#'}" class="btn-primary" style="font-size:0.75rem;padding:4px 10px;display:inline-block;margin-top:4px" target="_blank">Check Price</a>
        </div>
      </div>
    `).join('');
  }

  document.getElementById('cat').addEventListener('change', filter);
  document.getElementById('budget').addEventListener('change', filter);
  document.getElementById('tier').addEventListener('change', filter);
  document.getElementById('reset').addEventListener('click', () => {
    document.getElementById('cat').value = 'all';
    document.getElementById('budget').value = '0';
    document.getElementById('tier').value = 'all';
    filter();
  });
  filter();
  </script>
</body>
</html>
          <th style="padding:8px 6px;">Porter-Cable C2002</th>
        </tr>
      </thead>
      <tbody>
        <tr style="border-bottom:1px solid var(--border);"><td style="padding:8px 6px;">Price</td><td style="padding:8px 6px;">$412.50</td><td style="padding:8px 6px;">$149.99</td></tr>
        <tr style="border-bottom:1px solid var(--border);"><td style="padding:8px 6px;">CFM @ 90 psi</td><td style="padding:8px 6px;"><strong>5.30</strong></td><td style="padding:8px 6px;"><strong>2.60</strong></td></tr>
        <tr style="border-bottom:1px solid var(--border);"><td style="padding:8px 6px;">Tank</td><td style="padding:8px 6px;">10 gallons</td><td style="padding:8px 6px;">6 gallons</td></tr>
        <tr style="border-bottom:1px solid var(--border);"><td style="padding:8px 6px;">Pump</td><td style="padding:8px 6px;">2.0 HP rated, oil-lubed</td><td style="padding:8px 6px;">Oil-free</td></tr>

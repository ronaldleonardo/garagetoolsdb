---
import { tools } from '../lib/data.mjs';

const posts = [
  {
    title: "Best Floor Jack for DIY Mechanics: I Watched My First One Slump",
    url: "/posts/best-floor-jack-review",
    desc: "I bought a cheap floor jack and watched it slump two inches with my car on top of it. I tested 5 floor jacks. Here is what I learned about capacity, low profile height, and which one to buy.",
    date: "2026-09-18",
    cat: "Reviews"
  },
  {
    title: "Best Breaker Bar for DIY Mechanics: I Snapped One Before Learning My Lesson",
    url: "/posts/best-breaker-bar-review",
    desc: "I snapped a breaker bar trying to remove a seized bolt on my car. I learned the hard way about steel quality, length, and which bar actually holds up.",
    date: "2026-09-16",
    cat: "Reviews"
  },
  {
    title: "Best Impact Wrench for Home Mechanics: I Snapped My Breaker Bar First",
    url: "/posts/best-impact-wrench-review",
    desc: "I snapped a breaker bar trying to remove a stuck bolt on my car. Now I own 4 impact wrenches. Here is what I learned about torque, battery life, and which one to buy.",
    date: "2026-09-11",
    cat: "Reviews"
  },
  {
    title: "Best Socket Set for DIY Mechanics: I Bought 3 Wrong Ones Before Finding the Right One",
    url: "/posts/best-socket-set-review",
    desc: "I bought 3 socket sets before I got it right. A $20 one, a 258-piece master set I barely used, and one that clicked. Here is what to look for.",
    date: "2026-09-09",
    cat: "Reviews"
  },
  {
    title: "Best OBD2 Scanner for Home Mechanics: What I Learned After Buying 3 Wrong Ones",
    url: "/posts/best-obd2-scanner-review",
    desc: "I bought 3 OBD2 scanners before finding the right one. Heres what I learned about what actually matters for DIY car repair.",
    date: "2026-09-05",
    cat: "Reviews"
  },
  {
    title: "Floor Jack Safety: 5 Things Nobody Told Me Before I Started Working Under My Car",
    url: "/posts/floor-jack-safety-tips",
    desc: "I almost learned this the hard way. These 5 floor jack safety tips will keep you alive while working on your car.",
    date: "2026-09-04",
    cat: "Guides"
  }
];
const catSlugs = Object.keys(tools);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Garage Tools DB | Compare & Find the Right Tool for Your DIY Car Project</title>
  <meta name="description" content="Honest tool comparisons and guides for DIY mechanics. OBD2 scanners, floor jacks, socket sets, torque wrenches, jump starters. Real specs, real prices." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/styles/global.css" />
  <!-- Analytics -->
  <script>(function(){var p=window.location.pathname;var r=document.referrer||'';(new Image()).src='http://localhost:8085/track?s=garagetoolsdb&p='+encodeURIComponent(p)+'&r='+encodeURIComponent(r)})();</script>
  <link rel="canonical" href="https://garagetoolsdb.com/" />
</head>
<body>
  <header>
    <div class="container">
      <a href="/" class="logo">🔧 GarageToolsDB</a>
      <button class="burger" id="burger" onclick="toggleNav()">
        <span></span><span></span><span></span>
      </button>
      <nav id="nav">
        <a href="/">Home</a>
        <a href="/posts">Blog</a>
        <a href="/finder">Find Tool</a>
        <div class="nav-item" onclick="if(window.innerWidth<=640)this.classList.toggle('open')">
          <span class="nav-trigger">Tools</span>
          <div class="dropdown">
            {Object.keys(tools).map(slug => (
              <a href={`/tools/${tools[slug].slug}`}>{tools[slug].short}</a>
            ))}
          </div>
        </div>
      </nav>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h1>Find the right tool. Skip the trial and error.</h1>
      <p>Every DIY mechanic has bought the wrong tool once. We are here to make sure it does not happen twice. Side-by-side comparisons of the tools that matter for home car repair, plus honest guides from someone who learned the hard way.</p>
    </section>

    <section>
      <h2>Compare Tools</h2>
      <div class="category-grid">
        {catSlugs.map(slug => {
          const t = tools[slug];
          return (
            <a href={`/tools/${t.slug}`} class="category-card">
              <h3>{t.name}</h3>
              <p>{t.desc}</p>
            </a>
          );
        })}
      </div>
    </section>

    <section class="recent-section">
      <div class="section-title">
        <h2>Latest Guides</h2>
        <a href="/posts" style="font-size:0.85rem;color:var(--accent);text-decoration:none;">View all →</a>
      </div>
      {posts.map(p => (
        <a href={p.url} class="preview-card">
          <div class="preview-body">
            <div style="color:var(--muted);font-size:0.78rem;margin-bottom:4px;">{p.cat} · {p.date}</div>
            <h3>{p.title}</h3>
            <p class="preview-desc">{p.desc}</p>
          </div>
        </a>
      ))}
    </section>
  </main>

  <footer>
    <div class="container">
      <p>© 2026 Garage Tools DB. As an Amazon Associate I earn from qualifying purchases. Prices may vary.</p>
    </div>
    <div style="text-align:center;font-size:0.78rem;color:#9ca3af;padding:0.5rem 1.25rem;border-top:1px solid #e5e7eb;margin-top:0.5rem;">
      Also visit: <a href="https://tabletopharvest.com" target="_blank" rel="nofollow" style="color:#6b7280;text-decoration:underline;">Tabletop Harvest</a> · <a href="https://tabletoppicks.com" target="_blank" rel="nofollow" style="color:#6b7280;text-decoration:underline;">Tabletop Picks</a> · <a href="https://sinapeos.com" target="_blank" rel="nofollow" style="color:#6b7280;text-decoration:underline;">Sinapeos</a>
    </div>
  </footer>
</body>
</html>

<script is:inline>
  function toggleNav() {
    document.getElementById('nav').classList.toggle('open');
    document.getElementById('burger').classList.toggle('open');
  }
  document.addEventListener('click', function(e) {
    const link = e.target.closest('a');
    if (link && link.hostname !== location.hostname && link.hostname !== '') {
      link.target = '_blank';
      link.rel = 'noopener';
    }
  });
</script>